# Local development settings (production values live in the root .env used by docker compose)
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://docformatter:docformatter@127.0.0.1:5434/docformatter
OLLAMA_URL=http://192.168.0.84:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT=600
CHUNK_CHARS=24000
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=20
MAX_INPUT_CHARS=300000
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
