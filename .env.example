# Production settings for `docker compose up -d --build`. Copy to .env and edit.

# Required. Use URL-safe characters only (it is embedded in the database URL), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Ollama server and model
OLLAMA_URL=http://192.168.0.84:11434
OLLAMA_MODEL=gpt-oss:20b

# How many documents the LLM formats at once (raise only if the GPU can handle parallel requests),
# and how many may be running + waiting before new requests are refused with HTTP 429.
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=20

MAX_UPLOAD_MB=20
LOG_LEVEL=INFO

# Where the web UI listens. Set HTTP_BIND=127.0.0.1 when a reverse proxy on this host terminates TLS.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# Image tag
APP_VERSION=1.1.0
